<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Download POI da Overpass API (solo con Karoo in tethering) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Popup overlay sopra il ride-app -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <!-- No io.hammerhead.karooext.MANIFEST_URL while the repository is private:
             the Karoo store fetches that URL every time the extension is opened
             from its library, gets a 404 and shows RETRY instead of opening the
             app (seen on 06/09/2026, four attempts). Declare it again, pointing
             to .../releases/latest/download/manifest.json, only once a public
             release with manifest.json exists. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".PoiAheadExtension"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="io.hammerhead.karooext.KAROO_EXTENSION" />
            </intent-filter>
            <meta-data
                android:name="io.hammerhead.karooext.EXTENSION_INFO"
                android:resource="@xml/extension_info" />
        </service>

    </application>
</manifest>
