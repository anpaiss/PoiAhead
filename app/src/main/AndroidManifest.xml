<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Download POI da Overpass API (solo con Karoo in tethering) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The app screen tells whether the Wi-Fi is off before and after a download (1.2.1) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Popup overlay sopra il ride-app -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <!-- The Karoo Extensions library reads this JSON (uploaded with every
             release) for description, screenshots and update check. While the
             repository is private the URL gives 404 and opening the extension
             from the library shows RETRY; the app still opens from the app list. -->
        <meta-data
            android:name="io.hammerhead.karooext.MANIFEST_URL"
            android:value="https://github.com/anpaiss/PoiAhead/releases/latest/download/manifest.json" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".PoiAheadExtension"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="io.hammerhead.karooext.KAROO_EXTENSION" />
            </intent-filter>
            <meta-data
                android:name="io.hammerhead.karooext.EXTENSION_INFO"
                android:resource="@xml/extension_info" />
        </service>

        <!-- Interruttore "Water alerts" per il popup Switches (libreria KarooSwitches):
             esportato, protetto dal permesso a firma, cosi' solo le nostre estensioni lo vedono -->
        <receiver
            android:name=".WaterAlertsSwitch"
            android:exported="true"
            android:permission="com.anpaiss.karooswitches.CONTROL">
            <intent-filter>
                <action android:name="com.anpaiss.karooswitches.SWITCH" />
            </intent-filter>
            <meta-data
                android:name="com.anpaiss.karooswitches.label"
                android:value="Water alerts" />
        </receiver>

    </application>
</manifest>
