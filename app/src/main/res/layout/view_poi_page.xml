<?xml version="1.0" encoding="utf-8"?>
<!-- Pagina dati full-page: 4 righe POI + stato. Niente contenuto critico in
     fondo: la fascia bassa può essere coperta dal banner "next cue". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp">

    <TextView
        android:id="@+id/tv_page_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="WATER AHEAD"
        android:textColor="#9E9E9E"
        android:textSize="14sp"
        android:letterSpacing="0.1"
        android:gravity="center" />

    <TextView
        android:id="@+id/tv_page_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="No data"
        android:textColor="#757575"
        android:textSize="18sp"
        android:gravity="center" />

    <LinearLayout
        android:id="@+id/row_poi_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tv_poi_name_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/tv_poi_dist_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#2196F3"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_poi_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tv_poi_name_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/tv_poi_dist_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#2196F3"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_poi_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tv_poi_name_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/tv_poi_dist_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#2196F3"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_poi_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tv_poi_name_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/tv_poi_dist_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#2196F3"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
