<?xml version="1.0" encoding="utf-8"?>
<ExtensionInfo
    displayName="@string/extension_name"
    icon="@drawable/ic_launcher"
    id="poi-ahead"
    mapLayer="true"
    scansDevices="false">

    <!-- Pagina POI — lista fonti acqua vicine con distanza -->
    <DataType
        typeId="poi-page"
        displayName="@string/poi_page_name"
        description="@string/poi_page_desc"
        graphical="true"
        icon="@drawable/ic_launcher" />

    <!-- Campo Switches (libreria KarooSwitches): tap = popup con gli interruttori di tutte le estensioni -->
    <DataType
        typeId="switches"
        displayName="@string/switches_name"
        description="@string/switches_desc"
        graphical="true"
        icon="@drawable/ic_launcher" />

</ExtensionInfo>
